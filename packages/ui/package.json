{
  "name": "@staqforce-studio/staqui",
  "version": "0.1.6",
  "description": "Compact, accessible React components with a quiet, botanical identity.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regzimarx/staqui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/regzimarx/staqui#readme",
  "bugs": "https://github.com/regzimarx/staqui/issues",
  "keywords": [
    "react",
    "components",
    "ui",
    "typescript",
    "accessible",
    "staqui"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsup src/index.ts --format esm,cjs --dts --external react --external react-dom --clean && cp src/styles.css dist/styles.css && mkdir -p dist/fonts && cp src/fonts/* dist/fonts/"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "lucide-react": "^0.468.0",
    "react-day-picker": "^9.11.1"
  }
}
